# requests/signup.http
#
# WHAT THIS IS
# Test requests for our sign-up API. Needs the "REST Client" extension.
# Click "Send Request" above any request to send it; the reply opens on the right.
# Run them top to bottom the first time (test 4 uses the code from test 1).
#
# To start fresh, run this in pgAdmin's Query Tool on the streamerdraft database:
#   DELETE FROM signups WHERE email LIKE '%@example.com';

@base = http://localhost:3000

### 1. A valid prospect → expect 201 + a referralCode
# @name prospect
POST {{base}}/api/signup
Content-Type: application/json

{
  "role": "prospect",
  "email": "  BassyMike@Example.com ",
  "displayName": "bassymike",
  "platform": "twitch",
  "channelUrl": "twitch.tv/bassymike",
  "streamCategory": "GTA RP",
  "ageConfirmed": true,
  "marketingOptIn": true
}

### 2. Same email, different capitals → expect 200 "resent" (a fresh link is emailed)
# If that email is already confirmed, you get 409 "already on the list" instead.
POST {{base}}/api/signup
Content-Type: application/json

{
  "role": "prospect",
  "email": "bassymike@EXAMPLE.com",
  "displayName": "someone else",
  "platform": "kick",
  "channelUrl": "kick.com/someone",
  "ageConfirmed": true
}

### 3. Broken prospect → expect 400 with a message for every bad field
POST {{base}}/api/signup
Content-Type: application/json

{
  "role": "prospect",
  "email": "not-an-email",
  "displayName": "b",
  "platform": "myspace",
  "channelUrl": "hello",
  "ageConfirmed": false
}

### 4. A valid scout who came through test 1's recruit link → expect 201
POST {{base}}/api/signup
Content-Type: application/json

{
  "role": "scout",
  "email": "creator@example.com",
  "displayName": "Big Creator",
  "platformUrls": ["tiktok.com/@bigcreator", "youtube.com/@bigcreator"],
  "audienceSize": "50k_100k",
  "contentTypes": ["short_form", "streaming"],
  "ageConfirmed": true,
  "ref": "{{prospect.response.body.$.referralCode}}"
}

### 5. Broken scout → expect 400 (no links, no audience size, no content types)
POST {{base}}/api/signup
Content-Type: application/json

{
  "role": "scout",
  "email": "scout2@example.com",
  "displayName": "Scout Two",
  "platformUrls": [],
  "ageConfirmed": true
}

### 6. Trying to be both → expect 400 "Choose prospect or scout."
POST {{base}}/api/signup
Content-Type: application/json

{
  "role": "both",
  "email": "both@example.com"
}

### 7. UK prospect, Cloudflare says GB → expect 201
# We send CF-IPCountry ourselves to pretend to be Cloudflare (localhost has none).
POST {{base}}/api/signup
Content-Type: application/json
CF-IPCountry: GB

{
  "role": "prospect",
  "email": "uk1@example.com",
  "displayName": "UK Streamer",
  "platform": "twitch",
  "channelUrl": "twitch.tv/ukstreamer",
  "ageConfirmed": true,
  "basedInUk": true
}

### 8. Scout, no UK tick, Cloudflare says US → expect 201 (anyone can join)
POST {{base}}/api/signup
Content-Type: application/json
CF-IPCountry: US

{
  "role": "scout",
  "email": "us1@example.com",
  "displayName": "US Creator",
  "platformUrls": ["youtube.com/@uscreator"],
  "audienceSize": "10k_50k",
  "contentTypes": ["videos"],
  "ageConfirmed": true
}

### 9. Junk country header → expect 201, country saved as empty (unknown)
POST {{base}}/api/signup
Content-Type: application/json
CF-IPCountry: hello

{
  "role": "prospect",
  "email": "junk@example.com",
  "displayName": "Junk Header",
  "platform": "kick",
  "channelUrl": "kick.com/junk",
  "ageConfirmed": true,
  "basedInUk": true
}

### 10. UK answer that isn't true/false → expect 400 "Answer yes or no."
POST {{base}}/api/signup
Content-Type: application/json

{
  "role": "prospect",
  "email": "bad@example.com",
  "displayName": "Bad Tick",
  "platform": "kick",
  "channelUrl": "kick.com/bad",
  "ageConfirmed": true,
  "basedInUk": "yes"
}