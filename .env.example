# Every secret the app needs, listed by name, with NO real values.
# This file IS uploaded to GitHub, so it's a checklist, not a vault.
# To set up: copy this file to .env.local and fill in real values there.

# B1: database connection
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/streamerdraft"

# B3: where the site lives (used to build links in emails)
APP_URL="http://localhost:3000"

# B3: email sending. Leave RESEND_API_KEY empty = dev mode (emails print in the terminal)
RESEND_API_KEY=
EMAIL_FROM="StreamerDraft <hello@streamerdraft.com>"

# B5: scrambles IP addresses. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it once the site is live.
IP_HASH_SECRET=

# B5: Cloudflare Turnstile ("are you human?"). Secret empty = check skipped (dev only)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# B6: admin dashboard login. Session secret: same command as IP_HASH_SECRET
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=